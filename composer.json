{
    "name": "cymdeveloppement/roundcube-odoo",
    "type": "roundcube-plugin",
    "description": "Read-only Odoo address book: suggests the Odoo contacts in the recipient autocompletion and lists them in the Contacts screen",
    "license": "MIT",
    "authors": [
        {
            "name": "Yann Challet",
            "homepage": "https://github.com/CymDeveloppement",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://github.com/CymDeveloppement/roundcube-odoo",
    "require": {
        "php": ">=7.3",
        "ext-json": "*",
        "roundcube/plugin-installer": ">=0.3.0"
    },
    "extra": {
        "roundcube": {
            "min-version": "1.6.0"
        }
    },
    "keywords": [
        "roundcube",
        "roundcube-plugin",
        "odoo",
        "contacts",
        "addressbook",
        "autocomplete",
        "webmail"
    ],
    "support": {
        "issues": "https://github.com/CymDeveloppement/roundcube-odoo/issues",
        "source": "https://github.com/CymDeveloppement/roundcube-odoo"
    }
}
